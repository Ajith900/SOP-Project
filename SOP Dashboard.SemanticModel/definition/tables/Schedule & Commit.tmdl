	measure 'Short Receipt_2' =
			
			VAR SR = [Short Commitment]
			
			RETURN
			IF(
			    SELECTEDVALUE('Schedule & Commit'[CBU Head]) =
			        CALCULATE(
			            MIN('Schedule & Commit'[CBU Head]),
			            ALLEXCEPT('Receipt', 'Receipt'[Plant_New])
			        ),
			    SR,
			    BLANK()
			)
		lineageTag: 69ddcc1a-3c0f-4962-a0ac-4cfa5a4267f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Commitment' =
			
