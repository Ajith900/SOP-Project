			    )
			)
		lineageTag: e40ea1d7-058a-4b0a-aa4f-2214926aae8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Receipt_new =
			
			CALCULATE(
			    SUM(Receipt[Receipt]),
			    USERELATIONSHIP(
			        Receipt[Material_Vendor],
			        'Schedule & Commit'[Material_Vendor]
			    )
			)
		lineageTag: 0c48a154-10b6-4e99-8a3b-2860c3ce0b2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receipt final' =
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View]),
			
			    // ✅ Quantity
			    "Quantity",
			        CALCULATE(
			            SUM('Receipt'[Receipt]),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        ),
			
			    // ✅ PO Price
			    "PO Price",
			        CALCULATE(
			            SUMX(
			                'Receipt',
			                'Receipt'[Receipt] *
			                CALCULATE(MAX('Po Price'[Net Price ]))
			            ),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        )/100000,
			
			    // ✅ Aftermarket (FIXED using USERELATIONSHIP)
			    "Aftermarket",
			        CALCULATE(
			            SUMX(
			                'Receipt',
			                'Receipt'[Receipt] *
			                VAR DomesticPrice =
			                    CALCULATE(
			                        MAX('Domestic_AM Price'[Unit Price]),
			                        USERELATIONSHIP(
			                            'Receipt'[Material No],
			                            'Domestic_AM Price'[Material Code]
			                        )
			                    )
			                VAR ExportPrice =
			                    CALCULATE(
			                        MAX('Exports_AM Price'[Unit Price]),
			                        USERELATIONSHIP(
			                            'Receipt'[Material No],
			                            'Exports_AM Price'[Material Code]
			                        )
			                    )
			                RETURN
			                    SWITCH(
			                        TRUE(),
			                        DomesticPrice = 0, ExportPrice,
			                        ExportPrice = 0, DomesticPrice,
			                        (DomesticPrice + ExportPrice) / 2
			                    )
			            ),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        )/100000
			)
		formatString: 0
		lineageTag: 8cca2ea3-8fba-4049-a535-f378e54ae522

	measure 'Receipt as per Commitment final' =
			
			SUMX(
			    SUMMARIZE(
			        'Schedule & Commit',
			        'Schedule & Commit'[Material_Vendor]-- adjust if needed
			    ),
			    VAR CommitVal =
			        CALCULATE([Commit_ Final_])
			    VAR ReceiptVal =
			        CALCULATE([Receipt final])
			    RETURN
			        MIN(CommitVal, ReceiptVal)
			)
		formatString: 0
		lineageTag: f0cd6266-b893-4a59-a0a8-f20d1735d431

	measure '% Received on commitment' =
			
			DIVIDE(
			    [Receipt as per Commitment final],[Commit_ Final_],0)
		formatString: 0%;-0%;0%
		lineageTag: f9a88c2e-8b90-4501-8ee8-f1ac0eb6f22a

	measure 'Final Receipt _1' = ```
			
			 CALCULATE(
			            SUM('Receipt'[Receipt]),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        )
			```
		formatString: 0
		lineageTag: c1d40607-bd01-46f7-b1a5-fbdb09708eda

	measure 'Export ASK Final' = ```
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View]),
			
			    // ✅ Quantity (deduplicated)
			    "Quantity",
			        CALCULATE(
			            SUMX(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                CALCULATE(MAX('Schedule & Commit'[Exports ASK]))
			            ),
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			
			    // ✅ PO Price (FIXED)
			    "PO Price",
			         CALCULATE(
			            SUMX(
			                'Schedule & Commit',
			                'Schedule & Commit'[Exports ASK] *
			                CALCULATE(MAX('Po Price'[Net Price ]))
			            )/400000,
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			
			    // ✅ Aftermarket
			    "Aftermarket",
			 CALCULATE( SUMX( 'Schedule & Commit', 'Schedule & Commit'[Exports ASK] * VAR DomesticPrice = CALCULATE(MAX('Domestic_AM Price'[Unit Price])) VAR ExportPrice = CALCULATE(MAX('Exports_AM Price'[Unit Price])) RETURN SWITCH( TRUE(), DomesticPrice = 0, ExportPrice, ExportPrice = 0, DomesticPrice, (DomesticPrice + ExportPrice) / 2 ) )/400000, REMOVEFILTERS('Schedule & Commit'[Week]) ) 
			)
			```
		lineageTag: 35ffe39b-875b-4b27-9980-ac1788ee4bf6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Receipt' =
			
			MAX([Commit_ Final_] - [Receipt as per Commitment final], 0)
		formatString: 0
		lineageTag: 2d4c6006-0433-4be6-b6cf-410982069f42

	measure '% Received on commitment_SKU' =
			
			DIVIDE(
			    [Receipt as per Commitment final],
			    CALCULATE(
			        [Commit_ Final_],
			        REMOVEFILTERS('Schedule & Commit'[Week])
			    ),
			    0
			)
		lineageTag: f682c741-f979-4842-bacf-1ee519becff8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receipt final for receipt' =
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View], "PO Price"),  -- ✅ default here
			
			    "Quantity",
			        CALCULATE(
			            SUM('Receipt'[Receipt]),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        ),
			
			    "PO Price",
			        CALCULATE(
			            SUMX(
			                'Receipt',
			                'Receipt'[Receipt] *
			                CALCULATE(MAX('Po Price'[Net Price ]))
			            ),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        ) / 100000,
			
			    "Aftermarket",
			        CALCULATE(
			            SUMX(
			                'Receipt',
			                'Receipt'[Receipt] *
			                VAR DomesticPrice =
			                    CALCULATE(
			                        MAX('Domestic_AM Price'[Unit Price]),
			                        USERELATIONSHIP(
			                            'Receipt'[Material No],
			                            'Domestic_AM Price'[Material Code]
			                        )
			                    )
			                VAR ExportPrice =
			                    CALCULATE(
			                        MAX('Exports_AM Price'[Unit Price]),
			                        USERELATIONSHIP(
			                            'Receipt'[Material No],
			                            'Exports_AM Price'[Material Code]
			                        )
			                    )
			                RETURN
			                    SWITCH(
			                        TRUE(),
			                        DomesticPrice = 0, ExportPrice,
			                        ExportPrice = 0, DomesticPrice,
			                        (DomesticPrice + ExportPrice) / 2
			                    )
			            ),
			            TREATAS(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                'Receipt'[Material_Vendor]
			            )
			        ) / 100000
			)
		lineageTag: cd1e875a-cea1-4649-be53-958399144f58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receipt as per Commitment final for receipt' =
			
			SUMX(
			    SUMMARIZE(
			        'Schedule & Commit',
			        'Schedule & Commit'[Material_Vendor]
			    ),
			    VAR CommitVal = [Commit_ Final_]
			    VAR ReceiptVal = [Receipt final]
			    RETURN
			        MIN(CommitVal, ReceiptVal)
			)
		lineageTag: 1feb1d51-7a6a-4250-8999-b721d5f45be1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Received on commitment for receipt' =
			
			DIVIDE(
			    SUMX(
			        VALUES('Schedule & Commit'[Material_Vendor]),
			        VAR CommitVal =
			            CALCULATE(
			                [Commit_ Final_],
			                REMOVEFILTERS('Toggle'),
			                'Toggle'[View] = "PO Price"
			            )
			        VAR ReceiptVal =
			            CALCULATE(
			                [Receipt final],
			                REMOVEFILTERS('Toggle'),
			                'Toggle'[View] = "PO Price"
			            )
			        RETURN
			            MIN(CommitVal, ReceiptVal)
			    ),
			    CALCULATE(
			        [Commit_ Final_],
			        REMOVEFILTERS('Toggle'),
			        'Toggle'[View] = "PO Price"
			    ),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 12461fa0-8c89-4ac1-9bee-99d79109a333

