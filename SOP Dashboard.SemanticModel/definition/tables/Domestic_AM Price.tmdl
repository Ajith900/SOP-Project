	measure 'Domestic ASK Final' = ```
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View]),
			 
			    // ✅ Quantity (deduplicated)
			    "Quantity",
			        CALCULATE(
			            SUMX(
			                VALUES('Schedule & Commit'[Material_Vendor]),
			                CALCULATE(MAX('Schedule & Commit'[Domestic ASK]))
			            ),
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			 
			    // ✅ PO Price (multiply first, then sum)
			    "PO Price",
			        CALCULATE(
			            SUMX(
			                'Schedule & Commit',
			                'Schedule & Commit'[Domestic ASK] *
			                CALCULATE(MAX('Po Price'[Net Price ]))
			            ),
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			 
			    // ✅ Aftermarket (same logic as your Ask/Commit)
			    "Aftermarket",
			        CALCULATE(
			            SUMX(
			                'Schedule & Commit',
			                'Schedule & Commit'[Domestic ASK] *
			                VAR DomesticPrice =
			                    CALCULATE(MAX('Domestic_AM Price'[Unit Price]))
			                VAR ExportPrice =
			                    CALCULATE(MAX('Exports_AM Price'[Unit Price]))
			                RETURN
			                    SWITCH(
			                        TRUE(),
			                        DomesticPrice = 0, ExportPrice,
			                        ExportPrice = 0, DomesticPrice,
			                        (DomesticPrice + ExportPrice) / 2
			                    )
			            ),
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        )
			)
			```
		lineageTag: 8b1504cc-e2c1-462f-8c14-858db1a867a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ask Commitment Gap_final' =
			
			SUMX(
			    VALUES('Schedule & Commit'[Material Code]),
			
			    VAR TotalAsk =
			        CALCULATE(SUM('Schedule & Commit'[Ask]))
			
			    VAR TotalCommit =
			        CALCULATE(SUM('Schedule & Commit'[Commit]))
			
			    VAR Price =
			        CALCULATE(MAX('Po Price'[Net Price ]))
			
			    RETURN
			        (TotalAsk - TotalCommit) * Price
			)
		lineageTag: 1c454cad-c168-4819-a7e8-4f9165e71ebc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Receipt_SKU' =
			
			CALCULATE(
			    SUMX(
			        VALUES('Schedule & Commit'[Material_Vendor]),   -- 🔥 removes duplication
			
			        VAR CommitQty =
			            CALCULATE(SUM('Schedule & Commit'[Commit]))
			
			        VAR ReceiptQty =
			            CALCULATE(
			                SUM('Receipt'[Receipt]),
			                TREATAS(
			                    VALUES('Schedule & Commit'[Material_Vendor]),
			                    'Receipt'[Material_Vendor]
			                )
			            )
			
			        VAR GapQty =
			            CommitQty - ReceiptQty
			
			        VAR Price =
			            CALCULATE(
			                MAX('Po Price'[Net Price ]),
			                TREATAS(
			                    VALUES('Schedule & Commit'[Material Code]),   -- 🔥 ensures correct price
			                    'Po Price'[Material Code]
			                )
			            )
			
			        RETURN
			            IF(GapQty > 0, GapQty * Price)
			    ) / 100000,
			
			    REMOVEFILTERS('Schedule & Commit'[Week])
			)
		formatString: 0
		lineageTag: 12af4241-2ae3-4dac-9049-7aa7568faa76

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Commit_ Final_ for receipt' =
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View], "PO Price"),  -- ✅ default here
			
			    "Quantity",
			        SUM('Schedule & Commit'[Commit]),
			
			    "PO Price",
			        SUMX(
			            'Schedule & Commit',
			            'Schedule & Commit'[Commit] *
			            CALCULATE(MAX('Po Price'[Net Price ]))
			        ) / 100000,
			
			    "Aftermarket",
			        SUMX(
			            'Schedule & Commit',
			            'Schedule & Commit'[Commit] *
			            VAR DomesticPrice =
			                CALCULATE(MAX('Domestic_AM Price'[Unit Price]))
			            VAR ExportPrice =
			                CALCULATE(MAX('Exports_AM Price'[Unit Price]))
			            RETURN
			                SWITCH(
			                    TRUE(),
			                    DomesticPrice = 0, ExportPrice,
			                    ExportPrice = 0, DomesticPrice,
			                    (DomesticPrice + ExportPrice) / 2
			                )
			        ) / 100000
			)
		lineageTag: 6c5fe877-ac1b-40f0-97b8-3dba45b1d0a5

