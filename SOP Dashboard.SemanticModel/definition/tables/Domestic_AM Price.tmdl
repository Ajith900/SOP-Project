	measure 'View Note' =
			
			VAR SelectedView = SELECTEDVALUE('Toggle'[View])
			RETURN
			    SWITCH(
			        TRUE(),
			        SelectedView = "PO Price", "All values are in INR Lakhs",
			        SelectedView = "Aftermarket", "All values are in INR Lakhs",
			        SelectedView = "Quantity", "All values are in Units",
			        "Select a View"
			    )
