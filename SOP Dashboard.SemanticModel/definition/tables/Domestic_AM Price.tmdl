	measure 'Gap Final' =
			
			SUMX(
			    VALUES('Schedule & Commit'[Material Code]),
			    VAR CommitVal = [Commit Final]   -- already toggle based
			    VAR ReceiptAdj = [Receipt as per Commitment]  -- already toggle based
			    RETURN
			        CommitVal - ReceiptAdj
			)
		lineageTag: f904ddb3-bc14-40a4-a1fa-9b4ce02a72ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receipt (Mapped)' =
			
			CALCULATE(
			    SUM('Receipt'[Receipt]),
			    TREATAS(
			        VALUES('Schedule & Commit'[Material Code]),
			        'Receipt'[Material No]
			    )
			)
		lineageTag: 09b369b4-0bca-4d8b-a6d8-f3650a8c68ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receipt as per Commitment' =
			
			SUMX(
			    VALUES('Schedule & Commit'[Material Code]),
			    VAR CommitVal =
			        CALCULATE(SUM('Schedule & Commit'[Commit]))
			    VAR ReceiptVal =
			        CALCULATE(
			            SUM('Receipt'[Receipt]),
			            FILTER(
			                ALL('Receipt'),
			                'Receipt'[Material No] =
			                    SELECTEDVALUE('Schedule & Commit'[Material Code])
			            )
			        )
			    RETURN
			        MIN(CommitVal, ReceiptVal)
			)
		lineageTag: bf4dd776-09dc-43b7-9c36-e3d06eb63f61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ask Commitment Gap' = ```
			
			CALCULATE(
			    SUMX(
			        'Schedule & Commit',
			        VAR AskValue =
			            'Schedule & Commit'[Ask] *
			            CALCULATE(MAX('Po Price'[Net Price ]))
			
			        VAR CommitValue =
			            'Schedule & Commit'[Commit] *
			            CALCULATE(MAX('Po Price'[Net Price ]))
			
			        RETURN
			            IF(AskValue > CommitValue, AskValue - CommitValue)
			    ) / 100000,
			    
			    REMOVEFILTERS('Schedule & Commit'[Week])   -- 🔥 KEY ADDITION
			)
			```
		formatString: 0
		lineageTag: b4867df9-b003-4814-bcaa-304ce11221e7

