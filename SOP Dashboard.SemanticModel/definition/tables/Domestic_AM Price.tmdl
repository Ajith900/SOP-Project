	measure 'Total Receipt_2' =
			
			SUM('Receipt'[Receipt])
		lineageTag: cd9e1771-30f5-464b-aaa2-ecd9fe727b46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Receipt Final Clean' =
			
			VAR CommitQty =
			    CALCULATE(
			        SUM('Schedule & Commit'[Commit]),
			        REMOVEFILTERS('Schedule & Commit'[CBU Head]),
			        REMOVEFILTERS('Schedule & Commit'[Plant Head])
			    )
			
			VAR ReceiptQty =
			    CALCULATE(
			        SUM('Receipt'[Receipt]),
			        REMOVEFILTERS('Schedule & Commit'[CBU Head]),
			        REMOVEFILTERS('Schedule & Commit'[Plant Head])
			    )
			
			VAR Result =
			    CommitQty - ReceiptQty
			
			VAR FirstCBU =
			    CALCULATE(
			        MIN('Schedule & Commit'[CBU Head]),
			        ALLEXCEPT('Receipt', 'Receipt'[Plant_New])
			    )
			
			RETURN
			IF(
			    SELECTEDVALUE('Schedule & Commit'[CBU Head]) = FirstCBU,
			    Result,
			    BLANK()
			)
		lineageTag: c0744d1e-ef48-4577-bdb1-efdf8aa4264c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Short Receipt Clean' =
			
			VAR SR_Value =
			    CALCULATE(
			        [Short Receipt Final Clean],
			        REMOVEFILTERS('Schedule & Commit'[CBU Head])
			    )
			
			RETURN
			IF(
			    SR_Value > 0,
			    SR_Value,
			    BLANK()
			)
		lineageTag: 0ca86bee-7c27-47fd-a6cd-ce4c09b101b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Ask Value' =
			
			SUMX(
			    'Schedule & Commit',
			    'Schedule & Commit'[Ask] *
			    RELATED('Po Price'[Net Price ])
			)
		lineageTag: 6e7d052f-d6e0-42a8-949e-39d094a46433

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Commit Value' =
			
			SUMX(
			    'Schedule & Commit',
			    'Schedule & Commit'[Commit] *
			    RELATED('Po Price'[Net Price ])
			)
		lineageTag: 5b8ed88d-e68e-4190-9158-0f736d0184fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ask Final' =
			
			SWITCH(
			    SELECTEDVALUE('Toggle'[View]),
			
			    // ✅ Quantity
			    "Quantity",
			        CALCULATE(
			            SUM('Schedule & Commit'[Ask]),
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			
			    // ✅ PO Price
			    "PO Price",
			        CALCULATE(
			            SUMX(
			                'Schedule & Commit',
			                'Schedule & Commit'[Ask] *
			                CALCULATE(MAX('Po Price'[Net Price ]))
			            )/100000,
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        ),
			
			    // ✅ Aftermarket
			"Aftermarket",
			        CALCULATE(
			            SUMX(
			                'Schedule & Commit',
			                'Schedule & Commit'[Ask] *
			                VAR DomesticPrice =
			                    CALCULATE(MAX('Domestic_AM Price'[Unit Price]))
			                VAR ExportPrice =
			                    CALCULATE(MAX('Exports_AM Price'[Unit Price]))
			                RETURN
			                    SWITCH(
			                        TRUE(),
			                        DomesticPrice = 0, ExportPrice,
			                        ExportPrice = 0, DomesticPrice,
			                        (DomesticPrice + ExportPrice) / 2
			                    )
			            )/100000,
			            REMOVEFILTERS('Schedule & Commit'[Week])
			        )
			)
		formatString: 0
		lineageTag: 3fec2bd7-6a50-4c92-9eb5-46c892b08221

		annotation PBI_FormatHint = {"isDecimal":true}

