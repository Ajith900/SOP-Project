	column 'Receipt per Material' =
			
			VAR CurrentMaterial =
			    SELECTEDVALUE('Schedule & Commit'[Material Code])
			
			RETURN
			CALCULATE(
			    SUM('Receipt'[Receipt]),
			    FILTER(
			        ALL('Receipt'),
			        'Receipt'[Material No] = CurrentMaterial
			    )
			)
		lineageTag: f5e0c727-1643-421d-841b-e429c34b39a7
		summarizeBy: sum

