		        Splitter.SplitTextByDelimiter("_", QuoteStyle.Csv),
		        {"Type", "Week"}
		    ),
		
		    #"Trimmed Text" = Table.TransformColumns(#"Split Column", {{"Week", Text.Trim, type text}}),
		
		    #"Changed Type" = Table.TransformColumnTypes(#"Trimmed Text", {{"Value", type number}})
		
		in
		    #"Changed Type"
