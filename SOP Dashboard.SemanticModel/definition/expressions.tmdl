		let
		    Source = Excel.Workbook(SourceFile, null, true),
		    Sheet = Source{0}[Data],
		
		    #"Removed Top Rows" = Table.Skip(Sheet, 2),
		
		    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Top Rows", [PromoteAllScalars=true]),
		
		    #"Removed Columns" = Table.RemoveColumns(#"Promoted Headers", {"Total commitment ", "Total ASK"}),
		
